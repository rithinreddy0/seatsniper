FROM oven/bun:1.4.2
WORKDIR /app
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile --production
COPY src ./src
USER bun
ENV NODE_ENV=production PORT=10000
EXPOSE 10000
HEALTHCHECK --interval=60s --timeout=5s --start-period=60s CMD bun -e 'const r=await fetch("http://127.0.0.1:"+(process.env.PORT||10000)+"/health");process.exit(r.ok?0:1)'
CMD ["bun", "run", "src/render-monitor.ts"]
